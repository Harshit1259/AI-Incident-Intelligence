# Set to "production" to enforce JWT_SECRET requirement and disable dev warnings
ENV=development

HTTP_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173
POSTGRES_DSN=host=localhost port=5432 user=aiops_user password=CHANGE_ME dbname=aiops sslmode=disable
VITE_API_BASE_URL=http://localhost:8080/api/v1

# LLM — OpenAI or Anthropic key (auto-detected from key prefix)
LLM_API_KEY=sk-proj-REPLACE_WITH_YOUR_KEY
LLM_MODEL=gpt-4o
LLM_PROVIDER=        # "openai" | "anthropic" | "local" — auto-detected if empty

# LLM deployment mode (Phase 3 — BYOC / regulated customers)
# cloud   = default: use public OpenAI/Anthropic API (PII is scrubbed before send)
# private = call a custom LLM_BASE_URL endpoint (no data leaves your infra)
# offline = disable all LLM calls and use rule-based templates only
LLM_DATA_MODE=cloud
LLM_BASE_URL=        # e.g. http://ollama:11434 — required when LLM_DATA_MODE=private or LLM_PROVIDER=local

# Auth — MUST be set to a random 32+ character string in production
JWT_SECRET=CHANGE_ME_USE_openssl_rand_-base64_32

# Slack integration (optional)
SLACK_BOT_TOKEN=xoxb-REPLACE_IF_USING_SLACK
SLACK_SIGNING_SECRET=REPLACE_IF_USING_SLACK

# Auto-close: resolve an incident once all its alerts recovered and stayed
# quiet this long (Go duration, e.g. 5m, 10m).
AUTO_CLOSE_QUIET_PERIOD=5m

# ROI / Digest
SRE_HOURLY_COST=150
DIGEST_EMAIL=

# WhatsApp integration (optional)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# ──────────────────────────────────────────────────────────────────────────────
# NeuroOps Agent — Cryptographic Identity (per-agent HMAC signing)
# ──────────────────────────────────────────────────────────────────────────────
AGENT_INGEST_ENABLED=true

# AES-256 encryption key used to protect per-agent signing secrets at rest.
# Must be set to a 32+ character random string in production.
# Generate: openssl rand -base64 32
# If not set, derived from JWT_SECRET (acceptable for dev, not for production).
AGENT_SECRET_KEY=CHANGE_ME_USE_openssl_rand_-base64_32

# ── Production agent authentication flow ──────────────────────────────────────
# 1. Admin creates an enrollment token: POST /api/v1/agents/enrollment-tokens
# 2. Agent calls POST /api/v1/agents/register with X-Enrollment-Token: <token>
#    → receives a one-time AgentSecret in the response
# 3. Agent signs every ingest request with HMAC-SHA256:
#      canonical = "POST\n<agent_id>\n<unix_ts>\n<nonce>\n<hex(sha256(body))>"
#      X-Agent-ID: <agent_id>
#      X-Timestamp: <unix_seconds>
#      X-Nonce: <random_32_hex_chars>
#      X-Signature: hex(HMAC-SHA256(agent_secret, canonical))

# ── Legacy / dev fallback (deprecated) ────────────────────────────────────────
# If set, agents may still use X-Agent-Token: <value> to skip HMAC (dev only).
# Leave empty to disable the fallback and enforce per-agent identity everywhere.
AGENT_INGEST_TOKEN=

# ──────────────────────────────────────────────────────────────────────────────
# Platform Edition Gating
# ──────────────────────────────────────────────────────────────────────────────
# Comma-separated list of active product editions.
# Unlisted editions have their HTTP routes completely disabled at startup.
# Empty value (default) enables all editions — backward compatible.
#
# Editions:
#   core        — alert ingest, incident lifecycle, auth, source registry, billing
#   enterprise  — policy engine, immutable audit log, tenant config, admin tools
#   agent       — NeuroOps agent pipeline, log explorer, automated remediation
#   saasops     — SLO, anomaly, AI copilot, topology, risk, runbooks, digests
#
# Example — ship only the core incident platform:
#   PLATFORM_EDITIONS=core
#
# Example — core + enterprise governance, no agent or analytics:
#   PLATFORM_EDITIONS=core,enterprise
PLATFORM_EDITIONS=
